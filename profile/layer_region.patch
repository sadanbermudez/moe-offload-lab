+/* ---- Layer-region experiment (moe-offload-lab, not upstream) ----
+ * The CPU loop in moe_token_pipeline runs the routed experts one after
+ * another through coli_v4_expert_forward_ref, and every matvec in it opens its
+ * own OpenMP parallel region: two per rows16-packed expert (dual gate/up, down)
+ * and three per row-major expert (gate, up, down), with the activation
+ * quantization, bf16 rounding and SwiGLU done by one thread in between.
+ * v4_layer_region computes the same experts inside ONE parallel region:
+ *   1. gate and up row tiles of every expert, one work-shared loop;
+ *   2. bf16 rounding, SwiGLU and route weight, work-shared in 128-wide blocks;
+ *   3. down row tiles of every expert, one work-shared loop;
+ *   4. the expert sum (and the shared expert), work-shared over the hidden size.
+ * Each thread quantizes the activations into its own thread-local scratch
+ * (the same coli_fp8_activation_qdq_ref call the kernels make), so only the
+ * three barriers the data needs remain. Every row is computed by the same tile
+ * code as the reference kernels and the experts are summed in the same order,
+ * so the output is bit-identical. Returns 0 when it produced `output`; nonzero
+ * means the caller must zero `output` and run the reference loop (a layout this
+ * path does not take, or a failed scratch allocation). V4_LAYER_REGION=0 turns
+ * it off. */
+#if defined(_OPENMP) && defined(__AVX2__)
+#include "native_quant_fp4_rows16.h"
+#endif
+#if defined(_OPENMP) && defined(__AVX2__) && defined(COLI_FP4_ROWS16_KERNEL)
+#define V4_LAYER_REGION 1
+static int v4_lr_rowmajor_ok(const ColiTensorView *w) {
+    if (!w || w->gpu || w->format != COLI_TENSOR_FP4_NATIVE_BLOCK ||
+        w->scale_format != COLI_SCALE_UE8M0 || !w->data || !w->scales ||
+        w->rows < 1 || w->rows % 16 || w->columns < 1 || w->columns % 128 ||
+        w->block_rows != 1 || w->block_columns != 32) return 0;
+    size_t rows = (size_t)w->rows, columns = (size_t)w->columns;
+    return w->data_bytes == rows * (columns / 2) &&
+           w->scale_bytes == rows * (columns / 32);
+}
+
+static int v4_lr_packed_ok(const ColiTensorView *w) {
+    return w && !w->gpu && coli_fp4_rows16_v10_packed_ok(w);
+}
+
+static int v4_layer_region(float *output, const ColiExpertView *views,
+                           const float *route_weights, int count,
+                           const float *input, const float *shared,
+                           int d, float limit, int add_shared) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *value = getenv("V4_LAYER_REGION");
+        enabled = !(value && value[0] == '0');
+    }
+    enum { MAX_EXPERTS = 64 };
+    if (!enabled || !output || !views || !route_weights || !input ||
+        (add_shared && !shared) || count < 1 || count > MAX_EXPERTS ||
+        d < 1 || d % 128 || limit < 0.0f) return 1;
+    int packed[MAX_EXPERTS];
+    int64_t inter = views[0].gate.rows;
+    for (int k = 0; k < count; k++) {
+        const ColiExpertView *e = &views[k];
+        if (e->gate.rows != inter || e->up.rows != inter ||
+            e->gate.columns != d || e->up.columns != d ||
+            e->down.rows != d || e->down.columns != inter) return 1;
+        if (e->gate.block_rows == 16 && e->up.block_rows == 16 &&
+            e->down.block_rows == 16) {
+            if (!v4_lr_packed_ok(&e->gate) || !v4_lr_packed_ok(&e->up) ||
+                !v4_lr_packed_ok(&e->down)) return 1;
+            packed[k] = 1;
+        } else {
+            if (!v4_lr_rowmajor_ok(&e->gate) || !v4_lr_rowmajor_ok(&e->up) ||
+                !v4_lr_rowmajor_ok(&e->down)) return 1;
+            packed[k] = 0;
+        }
+    }
+    size_t n = (size_t)count, I = (size_t)inter, D = (size_t)d;
+    if (I % 128) return 1;
+    float *gate = malloc(n * I * sizeof(*gate));
+    float *up = malloc(n * I * sizeof(*up));
+    float *act = malloc(n * I * sizeof(*act));
+    float *down = malloc(n * D * sizeof(*down));
+    if (!gate || !up || !act || !down) {
+        free(down); free(act); free(up); free(gate); return 1;
+    }
+    const int64_t in_tiles = (int64_t)(I / 16), out_tiles = (int64_t)(D / 16);
+    const int64_t blocks = (int64_t)(I / 128);
+    const size_t scratch = D > n * I ? D : n * I;
+    int failed = 0;
+    #pragma omp parallel
+    {
+        float *x = NULL; uint8_t *x_scales = NULL;
+        int bad = coli_v4_qdq_scratch(scratch, scratch / 128, &x, &x_scales) ||
+                  coli_fp8_activation_qdq_ref(x, x_scales, input, D, 128);
+        /* 1. gate and up: (expert, matrix, row tile) jobs */
+        #pragma omp for schedule(static)
+        for (int64_t job = 0; job < (int64_t)n * 2 * in_tiles; job++) {
+            if (bad) continue;
+            int64_t k = job / (2 * in_tiles), r = job % (2 * in_tiles);
+            int is_up = r >= in_tiles;
+            int64_t tile = is_up ? r - in_tiles : r;
+            const ColiTensorView *w = is_up ? &views[k].up : &views[k].gate;
+            float *y = (is_up ? up : gate) + (size_t)k * I;
+            if (packed[k]) coli_fp4_rows16_v10_tile(y, w, x, tile);
+            else coli_fp4_rows16_order_tile(y, w->data, w->scales, x,
+                                            (int)D, tile);
+        }
+        /* 2. the elementwise step of coli_v4_expert_forward_ref, per block */
+        #pragma omp for schedule(static)
+        for (int64_t c = 0; c < (int64_t)n * blocks; c++) {
+            int64_t k = c / blocks;
+            size_t offset = (size_t)k * I + (size_t)(c % blocks) * 128;
+            coli_bf16_round_array(gate + offset, 128);
+            coli_bf16_round_array(up + offset, 128);
+            coli_v4_swiglu(act + offset, gate + offset, up + offset, 128, limit);
+            for (size_t i = 0; i < 128; i++)
+                act[offset + i] = coli_bf16_round(act[offset + i] *
+                                                  route_weights[k]);
+        }
+        /* 3. down: each thread quantizes every expert's activation, then
+         * takes its share of the (expert, row tile) jobs */
+        for (size_t k = 0; !bad && k < n; k++)
+            bad = coli_fp8_activation_qdq_ref(x + k * I, x_scales + k * (I / 128),
+                                              act + k * I, I, 128) != 0;
+        #pragma omp for schedule(static)
+        for (int64_t job = 0; job < (int64_t)n * out_tiles; job++) {
+            if (bad) continue;
+            int64_t k = job / out_tiles, tile = job % out_tiles;
+            const ColiTensorView *w = &views[k].down;
+            float *y = down + (size_t)k * D;
+            const float *xa = x + (size_t)k * I;
+            if (packed[k]) coli_fp4_rows16_v10_tile(y, w, xa, tile);
+            else coli_fp4_rows16_order_tile(y, w->data, w->scales, xa,
+                                            (int)I, tile);
+        }
+        /* 4. sum in expert order: output starts at zero, each expert's output
+         * is bf16-rounded and added, then the shared expert, as the loop does */
+        #pragma omp for schedule(static) nowait
+        for (int64_t i = 0; i < (int64_t)D; i++) {
+            float sum = output[i];
+            for (size_t k = 0; k < n; k++)
+                sum += coli_bf16_round(down[k * D + (size_t)i]);
+            output[i] = add_shared ? coli_bf16_round(sum + shared[i]) : sum;
+        }
+        if (bad) {
+            #pragma omp atomic write
+            failed = 1;
+        }
+    }
+    free(down); free(act); free(up); free(gate);
+    return failed;
+}
+#endif
